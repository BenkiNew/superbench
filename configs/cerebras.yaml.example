name: superbench-cerebras
version: 1.0.0
schema: v1
models:
  - name: Cerebras GPT-OSS 120B
    provider: openai
    apiBase: https://api.cerebras.ai/v1
    model: gpt-oss-120b
    apiKey: YOUR_CEREBRAS_API_KEY
    roles: [chat]
mcpServers:
  - name: Isolated benchmark fixture
    command: npx
    args: ['-y', '@modelcontextprotocol/server-filesystem', .superbench/workspace/current]
    cwd: .
