name: superbench-ollama-qwen
version: 1.0.0
schema: v1
models:
  - name: Qwen2.5 Coder 7B
    provider: ollama
    model: qwen2.5-coder:7b
    apiBase: YOUR_OLLAMA_HOST
    roles: [chat]
mcpServers:
  - name: Isolated benchmark fixture
    command: npx
    args: ['-y', '@modelcontextprotocol/server-filesystem', .superbench/workspace/current]
    cwd: .
