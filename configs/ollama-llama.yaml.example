name: superbench-ollama-llama
version: 1.0.0
schema: v1
models:
  - name: Llama 3.1 8B
    provider: ollama
    model: llama3.1:8b
    apiBase: YOUR_OLLAMA_HOST
    roles: [chat]
mcpServers:
  - name: Isolated benchmark fixture
    command: npx
    args: ['-y', '@modelcontextprotocol/server-filesystem', .superbench/workspace/current]
    cwd: .
