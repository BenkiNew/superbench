name: test-glm
version: 1.0.0
schema: v1
models:
  - name: GLM-5.2
    provider: openai
    apiBase: https://openrouter.ai/api/v1
    model: z-ai/glm-5.2:free
    apiKey: YOUR_API_KEY_HERE
    roles: [chat]
mcpServers:
  - name: Filesystem (projects)
    command: npx
    args: ['-y', '@modelcontextprotocol/server-filesystem', .]
    cwd: .
