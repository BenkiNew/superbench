name: superbench-groq
version: 1.0.0
schema: v1
models:
  - name: Groq GPT-OSS 120B
    provider: groq
    model: openai/gpt-oss-120b
    apiKey: YOUR_GROQ_API_KEY
    roles: [chat]
mcpServers:
  - name: Isolated benchmark fixture
    command: npx
    args: ['-y', '@modelcontextprotocol/server-filesystem', .superbench/workspace/current]
    cwd: .
