{
  "schema_version": 1,
  "pass_threshold": 75,
  "criteria": [
    {
      "id": "hardcoded-empty-list-at-call-site",
      "description": "Визначено, що endpoint.py рахує legacy_files (рядок 23), але викликає merge_sources() з захардкодженим порожнім списком [] (рядок 27) замість обчисленої змінної legacy_files",
      "weight": 35,
      "core": true,
