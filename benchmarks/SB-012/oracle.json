  ],
  "anti_patterns": [
    {
      "id": "blames-merge-sources-function",
      "penalty": 45,
      "patterns": ["bug (is |lies )?in merge_sources\\(\\)", "rewrite merge_sources", "merge_sources\\(\\) (is broken|has a bug|doesn't work)", "проблема в merge_sources"]
